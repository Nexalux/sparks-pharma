*.sqlite3-*
*.dump
*.sql
!drizzle/*.sql

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files
.env*
.dev.vars*
*.env
!/.env.example

